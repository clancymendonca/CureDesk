# services/api
DATABASE_URL=postgresql://curedesk:curedesk@localhost:5432/curedesk
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CORS_ORIGINS=http://localhost:3000,exp://localhost:8081
# Redis URI for shared rate limiting across workers (empty = in-memory)
RATE_LIMIT_STORAGE_URI=
FIREBASE_SERVICE_ACCOUNT_JSON=
SENTRY_DSN=
# Relative to the API working directory (services/api)
ARTIFACTS_DIR=models/artifacts
OCR_USE_GPU=auto
OCR_ENGINE=easyocr
MAX_UPLOAD_BYTES=5242880
OCR_TIMEOUT_SECONDS=30
WARMUP_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
