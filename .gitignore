# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# secrets
**/firebase-sa.json
*firebase-adminsdk*.json

# ML datasets (large downloads — keep small bundled label CSVs)
ml/data/symptoms/**/*
!ml/data/symptoms/README.md
ml/data/prescriptions/images/**
ml/data/prescriptions/rxhandbd/**
ml/data/prescriptions/hf_*/**
ml/data/prescriptions/kaggle_*/**
ml/data/drugs/**
ml/data/rag/**
ml/data/manifest.json

# Manual RxHandBD zips (Mendeley)
/RxHandBD*.zip
/RxHandBD*.zip.crdownload
